{
  "name": "cpe-backend",
  "version": "1.0.0",
  "description": "CPE — Controle de Programas Educacionais | API",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:migrate": "prisma migrate dev",
