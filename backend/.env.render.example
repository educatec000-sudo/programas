# Configure estes valores no painel do Render. Nunca envie o .env real ao Git.
NODE_ENV=production
API_PREFIX=/api
DATABASE_URL=COLE_A_URL_DO_POSTGRESQL_SUPABASE
FRONTEND_URL=https://SEU-FRONTEND.vercel.app
JWT_ACCESS_SECRET=GERE_UM_SEGREDO_FORTE_E_UNICO
JWT_REFRESH_SECRET=GERE_OUTRO_SEGREDO_FORTE_E_DIFERENTE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_HOURS=24
EXPOSE_RESET_URL=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
SEED_DEMO=false

# Somente para criar o primeiro administrador, se ainda não existir.
# Não execute seed automaticamente em cada deploy.
# INITIAL_ADMIN_NAME=Administrador CPE
# INITIAL_ADMIN_EMAIL=admin@seu-dominio.com.br
# INITIAL_ADMIN_PASSWORD=UMA_SENHA_TEMPORARIA_FORTE
