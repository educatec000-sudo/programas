# Banco PostgreSQL existente (local ou Supabase)
DATABASE_URL="postgresql://cpe:cpe@localhost:5432/cpe?schema=public"

# API
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Desenvolvimento local. Em produção o CORS usa somente FRONTEND_URL.
CORS_ORIGIN=http://localhost:5173
# FRONTEND_URL=https://SEU-FRONTEND.vercel.app

# Autenticação (gere valores fortes, diferentes e com 32+ caracteres)
JWT_ACCESS_SECRET=troque-por-um-segredo-access-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-refresh-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_HOURS=24
EXPOSE_RESET_URL=true

# Uploads locais. O filesystem padrão do Render é efêmero.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Seed local: true cria usuários e dados demonstrativos; false não cria demos.
# Em NODE_ENV=production os dados demo são sempre desabilitados.
SEED_DEMO=true

# Seed sem demos / produção: crie o primeiro administrador com credenciais próprias.
# A senha precisa ter ao menos 12 caracteres, letras e números.
# INITIAL_ADMIN_NAME=Administrador CPE
# INITIAL_ADMIN_EMAIL=admin@seu-dominio.com.br
# INITIAL_ADMIN_PASSWORD=troque-esta-senha-123
